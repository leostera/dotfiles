repo() {
  pushd "$(github-clone "$@")"
}

alias q="exit"
alias cat="bat --theme gruvbox-dark"
alias g="git"
alias gg="git"
alias status="git status"
alias clone="git clone"
alias init="git init"
alias vim="nvim"
alias v="nvim"
alias f="fzf"
alias vf="nvim \$(f)"
alias tmux="tmux -2 -f $HOME/.config/tmux/tmux.conf"
alias tma="tmux attach"
alias c="pushd \$(FZF_DEFAULT_COMMAND=\${FZF_DEFAULT_DIRECTORY_COMMAND} f)"
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias repos="pushd ~/Developer"
alias l="eza -lg"
alias la="eza -alH"
alias gitconf="nvim ~/.config/git/config"
alias reload="source ~/.zshrc"
alias tmuxrc="nvim ~/.config/tmux/tmux.conf"
alias nvimrc="nvim ~/.config/nvim/init.lua"
alias zshrc="nvim ~/.zshrc; reload"

for level in {1..9}; do
  tree_cmd="tree -C -L ${level} -h"
  t=$(repeat ${level} echo -n "t")
  eval "alias ${t}='${tree_cmd}'"
  eval "alias t${level}='${tree_cmd}'"
done
