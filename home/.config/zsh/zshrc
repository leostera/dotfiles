. "$HOME/.config/zsh/env"
. "$HOME/.config/zsh/path"
. "$HOME/.config/zsh/alias"
. "$HOME/.config/zsh/prompt"
fpath=(~/.config/zsh/completions $fpath)

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# bun completions and binaries, when installed separately.
if [ -s "$HOME/.bun/_bun" ]; then source "$HOME/.bun/_bun"; fi
if [ -d "$HOME/.bun/bin" ]; then export PATH="$HOME/.bun/bin:$PATH"; fi
