[include]
  path = ~/.config/git/config.local

[core]
  excludesfile = ~/.config/git/ignore
  editor = nvim

[alias]
  A = add -A
  amend = commit --amend
  b = branch -rv
  c = commit
  cam = commit -am
  cm = commit -m
  co = checkout
  cob = checkout -b
  cp = cherry-pick
  cpa = cherry-pick --abort
  cpc = cherry-pick --continue
  d = diff
  dh = diff HEAD
  fall = fetch --all
  fixup = commit --fixup
  l = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%C(bold blue)<%an> (%G?)%Creset' --abbrev-commit
  lo = log --color --stat
  p = push
  patch = apply --reject --ignore-whitespace --ignore-space-change
  purge = reset --hard HEAD
  ra = rebase --abort
  rc = rebase --continue
  rom = rebase origin/main
  s = status -s
  ss = status
  autosquash = rebase -i --autosquash
  t = tag
  tags = tag --sort "v:refname"
  unstage = reset --soft HEAD

[commit]
  gpgsign = false

[color]
  ui = auto

[diff]
  renames = copies
  tool = vimdiff

[difftool]
  prompt = false

[mergetool]
  prompt = false

[help]
  autocorrect = 1

[init]
  defaultBranch = main

[push]
  default = simple
  autoSetupRemote = true
  rebase = true

[credential "https://github.com"]
  helper = !gh auth git-credential

[credential "https://gist.github.com"]
  helper = !gh auth git-credential

[user]
  useConfigOnly = true
