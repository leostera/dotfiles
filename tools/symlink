#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
mkdir -p "$HOME/.config"

for conf in "$repo_root"/home/.config/*; do
  [ -d "$conf" ] || continue
  case "${conf##*/}" in
    # SSH keys and host configuration are local and must never be linked from
    # the repository checkout into the active SSH configuration.
    ssh|opencode) continue ;;
  esac
  ln -sfn "$conf" "$HOME/.config/"
done

# Pi state lives beside the checkout but is ignored, so create it on fresh
# clones before linking.
mkdir -p "$repo_root/home/.pi/agent"
ln -sfn "$repo_root/home/.pi" "$HOME/.pi"
ln -sfn "$repo_root/home/.agents" "$HOME/.agents"

# Pi reads global instructions only from its agent directory. Write a local
# pointer there so ~/.agents/AGENTS.md stays the single source.
pi_agents="$HOME/.pi/agent/AGENTS.md"
if [ -L "$pi_agents" ] || [ ! -e "$pi_agents" ]; then
  rm -f "$pi_agents"
  cat >"$pi_agents" <<'POINTER'
# Global Agent Instructions

Read `~/.agents/AGENTS.md` before starting any task and follow it. It holds
the global agent instructions; this file only points to it.
POINTER
fi

ln -sfn "$repo_root/home/.bin" "$HOME/.bin"
ln -sfn "$repo_root/home/.config/zsh/zshrc" "$HOME/.zshrc"
